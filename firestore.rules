rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()      { return request.auth != null; }
    function owner(uid)      { return signedIn() && request.auth.uid == uid; }
    function verified()      { return signedIn() && request.auth.token.email_verified == true; }

    // ── Profile: users/{uid} ───────────────────────────────────────────
    // ponytail: hasOnly includes exact fields written by loginform.html and eduskillUpdateProfile
    match /users/{uid} {
      allow read:   if owner(uid);
      allow create: if owner(uid)                       // sign-up happens before email is verified
                    && request.resource.size() < 20000
                    && request.resource.data.keys().hasOnly(['name','username','email','course','studentId','displayName','avatarUrl','bio','role','createdAt','updatedAt']);
      allow update: if owner(uid) && verified()
                    && request.resource.size() < 20000
                    && request.resource.data.keys().hasOnly(['name','username','email','course','studentId','displayName','avatarUrl','bio','role','createdAt','updatedAt']);
      allow delete: if owner(uid);

      // ── App data shards: users/{uid}/app/{core|quiz|timetable|notes|tasks_YYYY_MM|state} ──
      match /app/{docId} {
        allow read:   if owner(uid);
        allow create, update: if owner(uid) && verified()
                    && docId.matches('^(core|quiz|timetable|notes|state|tasks_[0-9]{4}_[0-9]{2})$')
                    && request.resource.size() < 900000
                    && request.resource.data.keys().hasOnly(['data','meta','updatedAt','schemaVersion']);
        allow delete: if owner(uid);
      }
    }

    // ── Username -> account map ────────────────────────────────────────
    match /usernames/{name} {
      allow get, list: if false;      // closed to prevent email enumeration (V1-SEC-05, V2-HIGH-07)
      allow create: if signedIn()
                    && name.matches('^[a-z0-9_]{3,20}$')
                    && request.resource.data.keys().hasOnly(['uid','email','createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email;
      allow update: if false;    // a claimed name can never be re-pointed
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
